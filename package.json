{
  "name": "mangaflow",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Tesseract OCR ile İngilizce manga metinlerini Türkçeye çeviren, yerel çoklu motor destekli Manifest V3 eklentisi",
  "license": "MIT",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "test": "node tools/core-test.cjs && node tools/translation-test.cjs && node --test tools/repository.test.mjs",
    "check": "node tools/check.mjs",
    "assets:install": "node tools/setup-assets.mjs",
    "test:assets": "node tools/assets-test.cjs",
    "test:engine": "node tools/engine-test.cjs",
    "test:browser": "node tools/integration.cjs",
    "test:performance": "node tools/performance-test.cjs",
    "verify": "node tools/verify.mjs",
    "build": "node tools/build.mjs",
    "package:source": "node tools/package-source.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "@napi-rs/canvas": "1.1.0",
    "fake-indexeddb": "6.2.7",
    "playwright": "1.65.0",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2",
    "yazl": "3.3.1"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
